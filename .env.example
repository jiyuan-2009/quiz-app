# 飞书应用配置
# 获取方式：飞书开放平台 -> 开发者后台 -> 创建应用 -> 凭证与基础信息
# 需要开通「多维表格」权限：bitable:app、bitable:record:write、bitable:record:read

FEISHU_APP_ID=cli_xxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 多维表格配置
# 打开你的多维表格，从 URL 中获取 base_token
# 例如：https://xxx.feishu.cn/base/XXXXXX  中的 XXXXXX
FEISHU_BASE_TOKEN=W20CbpxemaMpuesZTSwcwE7enCf

# 题库表 ID（数据表 ID，以 tbl 开头）
QUIZ_TABLE_ID=tblQF6QmmICc4mEp

# 答题记录表 ID
RECORD_TABLE_ID=tblhvkWe0fmSVEz2

# 服务端口
PORT=3000

# 管理员密码（用于题库管理页面）
ADMIN_PASSWORD=admin123
